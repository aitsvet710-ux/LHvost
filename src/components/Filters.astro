---
import { CATEGORY_META } from '../lib/categories';
import type { Category, ContentType } from '../lib/types';

/**
 * Фильтры архива: поиск и чипы-пилюли по рубрике, источнику и типу.
 * Состояние фильтров синхронизируется с query-параметрами адреса:
 * ?category=<слаг>&source=<название>&type=<тип>.
 */
interface Props {
  categories: Category[];
  sources: string[];
  contentTypes: ContentType[];
}

const { categories, sources, contentTypes } = Astro.props;

const groups = [
  {
    key: 'category',
    label: 'Рубрика',
    options: categories.map(name => ({
      value: name,
      label: name,
      slug: CATEGORY_META[name]?.slug ?? ''
    }))
  },
  {
    key: 'source',
    label: 'Источник',
    options: sources.map(name => ({ value: name, label: name, slug: '' }))
  },
  {
    key: 'type',
    label: 'Тип',
    options: contentTypes.map(name => ({ value: name, label: name, slug: '' }))
  }
];
---

<div class="card gap-5 p-5">
  <div>
    <label for="search" class="mb-1.5 block text-xs font-semibold uppercase tracking-wide text-graphite-600">
      Поиск
    </label>
    <input
      id="search"
      type="search"
      placeholder="Поиск по заголовку и краткому содержанию…"
      autocomplete="off"
      class="w-full rounded-chip border border-sand-200 bg-paper px-4 py-2.5 text-sm text-graphite-900 outline-none transition-colors placeholder:text-graphite-400 focus:border-terracotta-500 focus:bg-white"
    />
  </div>

  {
    groups.map(group => (
      <div>
        <p class="mb-2 text-xs font-semibold uppercase tracking-wide text-graphite-600">
          {group.label}
        </p>
        <div class="chips-scroll">
          <button
            type="button"
            class="chip-active"
            aria-pressed="true"
            data-filter={group.key}
            data-value=""
            data-slug=""
          >
            Все
          </button>
          {group.options.map(option => (
            <button
              type="button"
              class="chip-muted"
              aria-pressed="false"
              data-filter={group.key}
              data-value={option.value}
              data-slug={option.slug}
            >
              {option.label}
            </button>
          ))}
        </div>
      </div>
    ))
  }

  <p class="text-xs text-graphite-500">
    Показано <span id="filter-count">0</span> <span id="filter-noun">материалов</span>
  </p>
</div>

<script>
  import { plural } from '../lib/utils';

  const search = document.getElementById('search') as HTMLInputElement | null;
  const count = document.getElementById('filter-count');
  const noun = document.getElementById('filter-noun');
  const empty = document.querySelector<HTMLElement>('[data-empty]');
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-category]'));
  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-filter]'));
  const sections = Array.from(document.querySelectorAll<HTMLElement>('[data-month]'));

  const groups = ['category', 'source', 'type'];
  const active: Record<string, string> = { category: '', source: '', type: '' };

  function syncChips() {
    for (const chip of chips) {
      const group = chip.dataset.filter ?? '';
      const value = chip.dataset.value ?? '';
      const isActive = active[group] === value;
      chip.classList.toggle('chip-active', isActive);
      chip.classList.toggle('chip-muted', !isActive);
      chip.setAttribute('aria-pressed', String(isActive));
    }
  }

  /** Значение для адреса: рубрика — по слагу, остальные группы — по названию. */
  function urlValue(group: string): string {
    if (group !== 'category') return active[group];
    const chip = chips.find(
      item => item.dataset.filter === group && (item.dataset.value ?? '') === active[group]
    );
    return chip?.dataset.slug ?? '';
  }

  function updateUrl() {
    const url = new URL(window.location.href);
    for (const group of groups) {
      const value = urlValue(group);
      if (value) {
        url.searchParams.set(group, value);
      } else {
        url.searchParams.delete(group);
      }
    }
    window.history.replaceState({}, '', url);
  }

  function applyFilters() {
    const query = (search?.value ?? '').trim().toLowerCase();
    let visible = 0;

    for (const card of cards) {
      const matchQuery = !query || (card.dataset.search ?? '').includes(query);
      const matchCategory = !active.category || card.dataset.category === active.category;
      const matchSource = !active.source || card.dataset.source === active.source;
      const matchType = !active.type || card.dataset.contentType === active.type;

      const show = matchQuery && matchCategory && matchSource && matchType;
      card.style.display = show ? '' : 'none';
      if (show) visible++;
    }

    // Пустые месяцы скрываем, чтобы в ленте не оставалось заголовков без материалов.
    for (const section of sections) {
      const hasVisible = Array.from(
        section.querySelectorAll<HTMLElement>('[data-category]')
      ).some(card => card.style.display !== 'none');
      section.style.display = hasVisible ? '' : 'none';
    }

    if (count) count.textContent = String(visible);
    if (noun) noun.textContent = plural(visible, 'материал', 'материала', 'материалов');
    if (empty) empty.classList.toggle('hidden', visible !== 0);
  }

  for (const chip of chips) {
    chip.addEventListener('click', () => {
      const group = chip.dataset.filter ?? '';
      const value = chip.dataset.value ?? '';
      // Повторное нажатие на активный чип снимает фильтр.
      active[group] = active[group] === value ? '' : value;
      syncChips();
      applyFilters();
      updateUrl();
    });
  }

  search?.addEventListener('input', applyFilters);

  // Фильтр из адресной строки: /archive/?category=<слаг>&source=<название>&type=<тип>
  const params = new URLSearchParams(window.location.search);
  for (const group of groups) {
    const value = params.get(group);
    if (!value) continue;
    const chip =
      group === 'category'
        ? chips.find(item => item.dataset.filter === group && item.dataset.slug === value)
        : chips.find(item => item.dataset.filter === group && item.dataset.value === value);
    if (chip) active[group] = chip.dataset.value ?? '';
  }

  syncChips();
  applyFilters();
</script>
