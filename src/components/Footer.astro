---
import { getSiteName, getTagline, site } from '../lib/site';
import { withBase } from '../lib/utils';

const links = [
  { href: '/', label: 'Главная' },
  { href: '/archive/', label: 'Архив' }
];

/** Год в копирайте — считается на этапе сборки. */
const year = new Date().getFullYear();
---

<footer class="mt-16 border-t border-sand-200 bg-paper-100">
  <div class="mx-auto max-w-6xl px-4 py-12">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-3">
      <div>
        <a href={withBase('/')} class="flex flex-col leading-tight">
          <span class="font-serif text-lg font-bold text-graphite-900">{getSiteName()}</span>
          <span class="text-[11px] uppercase tracking-[0.18em] text-graphite-500">
            {getTagline()}
          </span>
        </a>
        <p class="mt-4 max-w-sm text-sm leading-relaxed text-graphite-600">{site.description}</p>
        <p class="mt-3 max-w-sm text-sm font-medium text-graphite-700">
          Сделано для тех, кто работает с деревом
        </p>
      </div>

      <nav class="flex flex-col gap-3" aria-label="Навигация в подвале">
        <p class="text-xs font-semibold uppercase tracking-wide text-graphite-500">Разделы</p>
        {links.map(link => (
          <a
            href={withBase(link.href)}
            class="text-sm font-medium text-graphite-700 hover:text-terracotta-600"
          >
            {link.label}
          </a>
        ))}
        <a
          href={site.vkUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="text-sm font-medium text-graphite-700 hover:text-terracotta-600"
        >
          Сообщество
        </a>
      </nav>

      <div class="flex flex-col items-start gap-4">
        <p class="text-xs font-semibold uppercase tracking-wide text-graphite-500">
          Подписка на дайджест
        </p>
        <p class="max-w-xs text-sm leading-relaxed text-graphite-600">
          Свежие материалы и разборы — в сообществе мастеров.
        </p>
        <a
          href={site.vkUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn bg-graphite-900 text-paper hover:bg-graphite-700"
        >
          Читать в ВК
        </a>
      </div>
    </div>

    <p class="mt-10 border-t border-sand-200 pt-6 text-xs leading-relaxed text-graphite-500">
      © {year} {getSiteName()}. Материалы ведут на первоисточники. Права на тексты и изображения
      принадлежат их авторам.
    </p>
  </div>
</footer>
