---
import type { Material } from '../lib/types';
import { CATEGORY_META, SOURCE_ICONS, SOURCE_LABELS } from '../lib/categories';
import { formatDate, readingTimeRu, relativeDateRu, withBase } from '../lib/utils';

interface Props {
  material: Material;
  /** Укороченная карточка: мелкий заголовок, без рамки вокруг текста. */
  compact?: boolean;
  /** Крупная карточка: занимает две колонки на десктопе. */
  featured?: boolean;
}

const { material, compact = false, featured = false } = Astro.props;

const meta = CATEGORY_META[material.category];
const sourceIcon = SOURCE_ICONS[material.sourceType] ?? SOURCE_ICONS.rss;
const sourceLabel = SOURCE_LABELS[material.sourceType] ?? material.sourceType;
const readLabel = readingTimeRu(`${material.summary ?? ''} ${material.description ?? ''}`);
---

<article
  class:list={['card card-lift', featured ? 'lg:col-span-2' : '']}
  data-category={material.category}
  data-source={material.source}
  data-content-type={material.contentType}
  data-search={`${material.title} ${material.summary ?? ''} ${material.tags?.join(' ') ?? ''}`.toLowerCase()}
>
  <div class="flex flex-1 flex-col gap-3 p-5">
    <div class="flex items-start justify-between gap-3">
      <span
        class:list={[
          'inline-flex items-center rounded-full px-3 py-1 text-xs font-semibold',
          meta?.badge ?? 'bg-graphite-800 text-sand-100'
        ]}
      >
        {material.category}
      </span>

      <span class="inline-flex items-center gap-1.5 pt-1 text-xs font-medium text-graphite-500">
        <svg
          class="h-4 w-4 shrink-0"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.7"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <Fragment set:html={sourceIcon} />
        </svg>
        {sourceLabel}
      </span>
    </div>

    <h3
      class:list={[
        'font-serif font-bold leading-snug text-graphite-900',
        featured ? 'text-xl sm:text-2xl' : compact ? 'text-base' : 'text-lg'
      ]}
    >
      <a href={withBase(`/${material.slug}/`)} class="line-clamp-2 hover:text-terracotta-600">
        {material.title}
      </a>
    </h3>

    {material.summary && (
      <p class="line-clamp-2 text-sm leading-relaxed text-graphite-600">{material.summary}</p>
    )}

    <div
      class="mt-auto flex flex-wrap items-center gap-x-4 gap-y-2 border-t border-sand-200 pt-3 text-xs text-graphite-500"
    >
      <time datetime={material.publishedAt} title={formatDate(material.publishedAt)}>
        {relativeDateRu(material.publishedAt)}
      </time>

      <span
        class="ml-auto inline-flex items-center gap-1 rounded-chip bg-sand-100 px-2 py-1 font-medium text-graphite-600"
      >
        {readLabel}
      </span>
    </div>
  </div>
</article>
