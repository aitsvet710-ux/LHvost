# Ключ OpenRouter — суммаризация и перевод материалов.
OPENROUTER_API_KEY=

# Альтернативный ключ OpenAI-совместимого API.
# Используется, если OPENROUTER_API_KEY не задан.
LLM_API_KEY=

# Ключ генерации изображений — обложки по рубрикам (необязательно).
IMAGE_GEN_API_KEY=

# Telegram: сессия для прямого сбора (необязательно).
TELEGRAM_SESSION=

# Режим сборки.
NODE_ENV=development
